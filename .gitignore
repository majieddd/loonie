__pycache__/
*.pyc
.env
.pytest_cache/

# 75 MB of parquet. Restored from actions/cache in CI, rebuilt locally by
# scripts/fetch_data.py. Never belongs in git history.
data/cache/

# The experience corpus. This is genuinely valuable training data -- the
# labelled pairing of a strategy with how it generalised forward -- but it
# grows without bound and is machine-local. Back it up deliberately; do not
# let it into the repo by accident.
data/experience/

# Rewritten every generation (~20s) and ~1 MB. Committing it would add a
# megabyte of churn to the repo every twenty seconds. The dashboard reads
# docs/data/snapshot.json instead, and CI reads docs/data/strategies.json.
state/evolve_state.json
state/*.log

# Per-process heartbeats: PIDs, hostname, and rewritten every few seconds.
# Local runtime plumbing. The PUBLISHED view of who is running lives in
# docs/data/snapshot.json, which the dashboard reads.
state/workers/
state/.last_push

# Generated HTML reports; the dashboard supersedes them.
reports/

# Design exploration drafts. Kept out of the published site.
design-demos/

# Vendored binaries (cloudflared is 52 MB and comes from upstream releases).
tools/

# These ARE committed on purpose:
#   state/paper_account.json   the book, ~11 KB, changes only on a trade
#   state/risk_state.json      kill-switch state and breach log
#   state/holdout_seal.json    the seal ledger -- this is a deliverable
#   docs/data/*.json           what GitHub Pages serves
data/universe/wide_panel.npz
